{
  // # Terminal
  "terminal.integrated.defaultProfile.windows": "Nushell",
  "terminal.integrated.profiles.windows": {
    "Nushell": {
      "path": ["C:\\Users\\mroncero\\AppData\\Local\\Programs\\nu\\bin\\nu.exe"]
    }
  },
  // -------------

  // # Formatting
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.semi": false,
  // -------------

  // # Appearance
  "editor.cursorBlinking": "smooth",
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#fc1fcd",
    "editor.selectionBackground": "#fc1fcc5d",
    "editor.lineHighlightBackground": "#e476ff1e"
  },
  // -------------

  // ## TodoTree
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text",
    "foreground": "#f33",
    "background": "#ffff",
    "opacity": 50,
    "iconColour": "#23a"
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "type": "line"
    },
    "FIXME": {
      "foreground": "#000",
      "iconColour": "#c9d338",
      "gutterIcon": true
    }
  },
  // -------------
  // # Vue
  "vue.hover.rich": true,
  // -------------
  // # Git
  "git.openRepositoryInParentFolders": "always",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  // -------------
  // # Misc
  "security.workspace.trust.untrustedFiles": "open",
  "update.mode": "manual",
  "explorer.confirmDelete": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always"
  // -------------
  // extensions
  // Vue (Official), EsLint, Prettier, TODO Tree
}

